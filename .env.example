# Paper trading is the default. Real Bybit market data, real model decisions, simulated fills.
# A simulated order rests on the live book and fills when a real public trade crosses its price.
# No API keys are required for a dry run.
DRY_RUN=true

# Live orders are sent only when DRY_RUN=false AND both keys are set.
# Leave these empty for paper trading. Never commit real keys.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# true: api-testnet.bybit.com and stream-testnet.bybit.com. false: mainnet.
# Mainnet orders still require DRY_RUN=false and keys.
BYBIT_TESTNET=false

# linear: USDT perpetual (default). spot: spot book. See the README for the difference.
BYBIT_CATEGORY=linear

# One-way mode is 0. Hedge mode is 1 for buy and 2 for sell. Linear only.
BYBIT_POSITION_IDX=0

# mock uses a momentum heuristic. jev calls the TypeSafe Jev model.
# Jev needs TYPESAFE_AI_API_KEY (the AI SDK reads it). No key is needed for mock.
MODEL=mock
TYPESAFE_AI_API_KEY=
JEV_MODEL_ID=jev-latest

# Both books run at once, each with its own position, quotes, and P&L.
SYMBOLS=SOLUSDT,XRPUSDT

# How often each symbol asks the model and refreshes its one resting order.
# 300 matches the old Monad block time. Two symbols at this pace stay under Bybit's
# order rate limit. MAX_ORDERS_PER_SEC is a local cap (Bybit's published order limit is 10/s).
LOOP_MS=300
MAX_ORDERS_PER_SEC=8
# The model is asked about the move over this many loops (100 * 300 ms is about 30 s).
HORIZON_TICKS=100

# Order size in base coin, ticks inside the touch (0 joins the best bid or ask), and the
# position cap in base coin. Names are {SYMBOL}_SIZE, {SYMBOL}_INSIDE_TICKS, {SYMBOL}_MAX_POSITION.
# Sizes are rounded to the instrument qty step and raised to the minimum notional.
# SOLUSDT min qty is usually 0.1. XRPUSDT size 5 clears the usual 5 USDT minimum.
SOLUSDT_SIZE=0.1
SOLUSDT_INSIDE_TICKS=1
SOLUSDT_MAX_POSITION=1
XRPUSDT_SIZE=5
XRPUSDT_INSIDE_TICKS=1
XRPUSDT_MAX_POSITION=50

# Used for the P&L percent. The kill switch is absolute USDT, across both symbols.
BANKROLL_USD=100
# When session P&L reaches minus this many USDT, all orders are cancelled and quoting stops.
MAX_LOSS_USD=25

# Optional. Unset uses Bybit's published non-VIP schedule in a dry run, or the account
# fee rate from /v5/account/fee-rate when keys are set.
# MAKER_FEE_RATE=0.0002
# TAKER_FEE_RATE=0.00055

# Optional overrides if the default hosts are blocked on your network.
# BYBIT_REST_URL=https://api.bybit.com
# BYBIT_PUBLIC_WS_URL=wss://stream.bybit.com/v5/public/linear
# BYBIT_PRIVATE_WS_URL=wss://stream.bybit.com/v5/private

# Public book depth. Linear: 1, 50, 200, 500, 1000. Spot: 1, 50, 200, 1000.
ORDERBOOK_DEPTH=50

PORT=3000
